PORT=5050
NODE_ENV=development
# Optional: fixed secret for signing login tokens (otherwise generated and stored in the database)
JWT_SECRET=
# Optional: comma-separated origins allowed to call the API from another domain
CORS_ORIGIN=
DATA_DIR=data
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Optional: back up content to a branch of the GitHub repo (needed on hosts with a temporary disk, like Render's free plan).
# GITHUB_TOKEN: fine-grained token with "Contents: read and write" on the repository.
# BACKUP_KEY: a long random password that encrypts the database. Use the same one everywhere and keep it safe.
GITHUB_TOKEN=
GITHUB_REPO=dennisngugiwambui/school-content-management-system
BACKUP_KEY=
BACKUP_BRANCH=cms-data
